{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["vite.config.ts", "scripts"],
  // These scripts import from src/, which is compiled under
  // tsconfig.app.json's bundler resolution (extension-less relative
  // imports). Pulling them into this nodenext project would force
  // explicit .js extensions across the whole graph they touch, so
  // they're excluded here and rely on `tsx` (type-stripping only) to run,
  // same as the other scripts in this directory. The imported modules are
  // still type-checked, via the app project.
  "exclude": ["scripts/preview-questions.ts", "scripts/normalize-sprites.ts"]
}
