{
  "name": "timescaler-trailer",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p .",
    "record": "tsx record.ts",
    "capture": "tsx capture/capture.ts",
    "capture:sheet": "tsx capture/sheet.ts",
    "capture:compare": "tsx capture/compare.ts",
    "studio": "remotion studio src/index.ts",
    "render:intro": "remotion render src/index.ts IntroLoop out/intro-hero.webm --codec=vp9 --crf=36",
    "render:poster": "remotion still src/index.ts IntroPoster out/intro-hero-poster.jpg --image-format=jpeg --jpeg-quality=82",
    "render:trailer": "remotion render src/index.ts Trailer out/timescaler-trailer.mp4 --codec=h264 --crf=23",
    "render:gif": "remotion ffmpeg -y -loglevel error -i out/intro-hero.webm -r 12 -filter_complex \"scale=420:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=128:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle\" out/timescaler.gif",
    "render": "pnpm record && pnpm render:intro && pnpm render:poster && pnpm render:trailer && pnpm render:gif && tsx publish.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "playwright": "1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
